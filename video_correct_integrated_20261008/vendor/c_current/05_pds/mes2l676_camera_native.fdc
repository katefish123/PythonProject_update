define_attribute {p:hd_rx_data[20]} {PAP_IO_LOC} {K20}
define_attribute {p:hd_rx_data[20]} {PAP_IO_VCCIO} {3.3}
define_attribute {p:hd_rx_data[20]} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:hd_rx_data[21]} {PAP_IO_DIRECTION} {INPUT}
