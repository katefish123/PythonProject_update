create_clock -name {rx_pixel} -period 6.734007 -waveform {0 3.367003} [get_ports {hd_rx_pclk}]

create_clock -name {cfg_clk} -period 100 [get_pins {pll/u_gpll:CLKOUT0}]
set_clock_groups -asynchronous -group [get_clocks {rx_pixel}] -group [get_clocks {cfg_clk}] -group [get_clocks {sys_clk_27m}]
set_input_delay -clock [get_clocks {rx_pixel}] -max 3.474 [get_ports {hd_rx_data[*] hd_rx_de hd_rx_hs hd_rx_vs}]
set_input_delay -clock [get_clocks {rx_pixel}] -min 1.626 [get_ports {hd_rx_data[*] hd_rx_de hd_rx_hs hd_rx_vs}]
create_generated_clock -name {tx_pixel} -divide_by 1 -source [get_ports {hd_rx_pclk}] [get_ports {hd_tx_pclk}]
set_output_delay -clock [get_clocks {tx_pixel}] -max 0.879 [get_ports {hd_tx_data[*] hd_tx_de hd_tx_hs hd_tx_vs}]
set_output_delay -clock [get_clocks {tx_pixel}] -min -0.22 [get_ports {hd_tx_data[*] hd_tx_de hd_tx_hs hd_tx_vs}]
