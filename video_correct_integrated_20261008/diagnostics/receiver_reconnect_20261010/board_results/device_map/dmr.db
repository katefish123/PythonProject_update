    <table id="device_map_timing_constraint" title="Timing Constraint" column_number="1">
        <column_headers>
            <data>Command</data>
        </column_headers>
        <row>
            <data>create_clock -name sys_clk_27m -period 37.037037 [get_ports {sys_clk_27m}]</data>
        </row>
        <row>
            <data>create_clock -name rx_pixel -period 6.734007 [get_ports {hd_rx_pclk}]</data>
        </row>
        <row>
            <data>create_clock -name cfg_clock -period 100 [get_pins {cp/u_gpll:CLKOUT0}]</data>
        </row>
        <row>
            <data>create_clock -name pixel_clock -period 6.734007 [get_pins {vp/u_gpll:CLKOUT0}]</data>
        </row>
        <row>
            <data>create_generated_clock -name tx_pixel -divide_by 1 -source [get_pins {vp/u_gpll:CLKOUT0}] [get_ports {hd_tx_pclk}]</data>
        </row>
        <row>
            <data>set_clock_groups -asynchronous -group [get_clocks {sys_clk_27m}] -group [get_clocks {rx_pixel}] -group [get_clocks {cfg_clock}] -group [get_clocks {pixel_clock tx_pixel}]</data>
        </row>
        <row>
            <data>set_input_delay -clock [get_clocks {rx_pixel}] -max 3.474 [get_ports {hd_rx_data[*] hd_rx_de hd_rx_hs hd_rx_vs}]</data>
        </row>
        <row>
            <data>set_input_delay -clock [get_clocks {rx_pixel}] -min 1.626 [get_ports {hd_rx_data[*] hd_rx_de hd_rx_hs hd_rx_vs}]</data>
        </row>
        <row>
            <data>set_output_delay -clock [get_clocks {tx_pixel}] -max 0.879 [get_ports {hd_tx_data[*] hd_tx_de hd_tx_hs hd_tx_vs}]</data>
        </row>
        <row>
            <data>set_output_delay -clock [get_clocks {tx_pixel}] -min -0.220 [get_ports {hd_tx_data[*] hd_tx_de hd_tx_hs hd_tx_vs}]</data>
        </row>
        <row>
            <data>set_false_path -from [get_ports {rst_n}]</data>
        </row>
        <row>
            <data>set_false_path -to [get_ports {led[*] hd_reset_n hd_scl hd_sda}]</data>
        </row>
        <row>
            <data>set_false_path -from [get_ports {hd_sda}]</data>
        </row>
    </table>
