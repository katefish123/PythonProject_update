  "old_frontend": " reg rx_vs_q,rx_hs_q,rx_de_q;reg [23:0] rx_rgb_q;\n always @(posedge hd_rx_pclk or negedge rx_rst)begin\n  if(!rx_rst)begin rx_vs_q<=0;rx_hs_q<=0;rx_de_q<=0;rx_rgb_q<=0;end\n  else begin rx_vs_q<=hd_rx_vs;rx_hs_q<=hd_rx_hs;rx_de_q<=hd_rx_de;rx_rgb_q<=hd_rx_data;end\n end",
  "new_frontend": " // External data is captured on the stable falling edge. Retiming all four\n // signals together on the next rising edge preserves a full internal cycle.\n reg rx_vs_f,rx_hs_f,rx_de_f;reg [23:0] rx_rgb_f;\n always @(negedge hd_rx_pclk or negedge rx_rst)begin\n  if(!rx_rst)begin rx_vs_f<=0;rx_hs_f<=0;rx_de_f<=0;rx_rgb_f<=0;end\n  else begin rx_vs_f<=hd_rx_vs;rx_hs_f<=hd_rx_hs;rx_de_f<=hd_rx_de;rx_rgb_f<=hd_rx_data;end\n end\n reg rx_vs_q,rx_hs_q,rx_de_q;reg [23:0] rx_rgb_q;\n always @(posedge hd_rx_pclk or negedge rx_rst)begin\n  if(!rx_rst)begin rx_vs_q<=0;rx_hs_q<=0;rx_de_q<=0;rx_rgb_q<=0;end\n  else begin rx_vs_q<=rx_vs_f;rx_hs_q<=rx_hs_f;rx_de_q<=rx_de_f;rx_rgb_q<=rx_rgb_f;end\n end",
  "metadata_bypass": {
    "old": " continuous_capture_geometry #(.MARKER_MODE(MARKER_MODE),.SRC_W(SRC_W),.SRC_H(SRC_H),.MIN_PIXELS(MIN_PIXELS),.MAX_PIXELS(MAX_PIXELS),.MAX_SPAN(MAX_SPAN),.BLACK_RMIN(BLACK_RMIN),.BLACK_RMAX(BLACK_RMAX),.BLACK_GMIN(BLACK_GMIN),.BLACK_GMAX(BLACK_GMAX),.BLACK_BMIN(BLACK_BMIN),.BLACK_BMAX(BLACK_BMAX),.P0_XMIN(P0_XMIN),.P0_XMAX(P0_XMAX),.P0_YMIN(P0_YMIN),.P0_YMAX(P0_YMAX),.P1_XMIN(P1_XMIN),.P1_XMAX(P1_XMAX),.P1_YMIN(P1_YMIN),.P1_YMAX(P1_YMAX),.P2_XMIN(P2_XMIN),.P2_XMAX(P2_XMAX),.P2_YMIN(P2_YMIN),.P2_YMAX(P2_YMAX),.P3_XMIN(P3_XMIN),.P3_XMAX(P3_XMAX),.P3_YMIN(P3_YMIN),.P3_YMAX(P3_YMAX),.FIFO_ADDR_BITS(FIFO_ADDR_BITS)) geometry(\n .rx_clk(rx_clk),.proc_clk(proc_clk),.rst_n(rst_n),\n .sample_valid(sample_valid),.sample_first(sample_first),.sample_bank(sample_bank),.sample_generation(sample_generation),.sample_x(sample_x),.sample_y(sample_y),.sample_rgb(rx_rgb),\n .close_valid(close_valid),.close_bank(close_bank),.close_ok(close_ok),.close_generation(close_generation),\n .metadata_valid(metadata_valid),.metadata_ready(metadata_ready),.metadata_data(metadata_data),.fault(geometry_fault));\n",
    "new": " // Fixed lens profile uses no marker metadata. Admission remains gated by\n // the complete source frame and terminal DDR writer ACK in the manager.\n // Do not clock an unused pixel/marker CDC path or make it a fault source.\n assign metadata_valid=1'b0;\n assign metadata_data=130'd0;\n assign geometry_fault=1'b0;\n",
    "parent_source_sha256": "76ed8eb30770492ddd6837dacd20cb2002fd8a04cc544acce526bfaa5b8c1141"
  },
  "physical_counter_frontend": {
    "old": " wire physical_vs;hdmi_vs_recover physical_vsync(.clk(hd_rx_pclk),.reset_n(clocks_ready),.de(hd_rx_de),.hs(hd_rx_hs),.vs_in(hd_rx_vs),.vs_out(physical_vs));",
    "new": " // The independent physical counter must use the same stable input edge.\n // Its reset remains independent of DDR/application retries.\n reg physical_vs_f,physical_hs_f,physical_de_f;\n always @(negedge hd_rx_pclk or negedge clocks_ready)begin\n  if(!clocks_ready)begin physical_vs_f<=0;physical_hs_f<=0;physical_de_f<=0;end\n  else begin physical_vs_f<=hd_rx_vs;physical_hs_f<=hd_rx_hs;physical_de_f<=hd_rx_de;end\n end\n reg physical_vs_q,physical_hs_q,physical_de_q;\n always @(posedge hd_rx_pclk or negedge clocks_ready)begin\n  if(!clocks_ready)begin physical_vs_q<=0;physical_hs_q<=0;physical_de_q<=0;end\n  else begin physical_vs_q<=physical_vs_f;physical_hs_q<=physical_hs_f;physical_de_q<=physical_de_f;end\n end\n wire physical_vs;hdmi_vs_recover physical_vsync(.clk(hd_rx_pclk),.reset_n(clocks_ready),.de(physical_de_q),.hs(physical_hs_q),.vs_in(physical_vs_q),.vs_out(physical_vs));"
  },
  "presentation": {
